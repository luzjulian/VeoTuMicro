# Copiá este archivo como .env y completá los valores. El .env NO se sube al repositorio.

PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/NOMBRE_DE_LA_BD

# Origen del frontend (Vite)
CORS_ORIGIN=http://localhost:5173

# Texto aleatorio de 32 caracteres o más
JWT_SECRET=cambiar_por_un_texto_aleatorio_de_32_o_mas_caracteres

# Certificados de discapacidad (PDF): carpeta del servidor y tamaño máximo
UPLOADS_DIR=./uploads/certificados
MAX_CERTIFICADO_MB=5

# Mail de validación (nodemailer).
# En desarrollo usá Mailtrap: copiá host, puerto, usuario y contraseña desde Mailtrap (Email Testing -> Inbox -> SMTP Settings).
# Si dejás SMTP_HOST vacío en desarrollo, el mail NO se envía: se imprime en la consola del backend.
# En producción SMTP_HOST es obligatoria.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VeoTuMicro <no-reply@veotumicro.local>
# Link que aparece en los mails
APP_URL=http://localhost:5173

# Opcional: el registro y el login permiten 5 intentos cada 15 minutos.
# Para probar muchas veces seguidas en desarrollo, subí el límite:
# AUTH_RATE_LIMIT_MAX=100
